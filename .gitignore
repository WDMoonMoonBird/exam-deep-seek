node_modules
dist
.env
*.log
.DS_Store
ssl.key
ssl.crt
ssl.pfx
# 证书与私钥（含阿里云证书 zip 包）
*.pem
*.key
*.crt
*_nginx.zip
# 服务端环境变量（client/.env.development 与 .env.production 为公开 URL 配置，保留跟踪）
server/.env.*
# ★R26（2026-10-18）：任何层级的 .env 派生文件默认忽略（原只精确忽略根 .env ⇒ .env.local/.env.production 等会漏）
.env
.env.*
# 例外：示例文件与前端公开配置必须继续可跟踪（negation 必须写在忽略规则之后）
!.env.example
!client/.env.development
!client/.env.production
DEV_LOG.md
server/test/e2e/.e2e-state.json
server/test-results/

# 运行时数据与本地工具状态
server/uploads/
backups/
.claude/
.codegraph/
.workbuddy/
server/test/TEST-REPORT.pdf
server/test/test-report.html
server/test/qrcode.svg

~$*

# ===== 流水线 / 实验产物（体积大或为本地状态，不入库）=====
# 实验数据与注入测试集（87M，可由生成器复现）
实验/
# 验证用临时脚本与探针（2888 文件 / 198M，用户约定「测试不入库」）
# 锚定仓库根：未锚定的 tests/ 会在大小写不敏感文件系统上吞掉 windows/tests 等子目录
/tests/
# 本地工具状态
.VSCodeCounter/
.agent-teams/
.cw_skill/
# 一次性探针脚本
server/tmp-probe-ref-answer.mjs
# 由 .md 生成的 PDF（可随时重新生成，避免入库后过期）
docs/**/*.pdf

# 探针/假装置若被以裸 flag 当路径调用，会在仓库根留下 --xxx/ 目录（已发生两次）
--*/
