generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================
// 1. users — 用户表
// ============================
model User {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  username   String    @db.VarChar(50)
  password   String    @db.VarChar(255)
  realName   String    @db.VarChar(50) @map("real_name")
  role         UserRole
  lastSchoolId Int?             @map("last_school_id") @db.UnsignedInt
  createdAt    DateTime         @default(now()) @map("created_at")
  deletedAt    DateTime?        @map("deleted_at")
  // ★R2-B67（WAVE2）：密码**最近一次设置/重置**的时间（nullable：历史行未写过 ⇒ 不参与失效判定）。
  // 语义 = 该口令的生效时刻；鉴权中间件用它比对 JWT iat ⇒ 改密/重置后**所有旧令牌**在下一次请求即 401。
  passwordChangedAt DateTime?   @map("password_changed_at")
  // ★H6（W2-P4 / t34）：首登强制改密标记。`@default(false)` ⇒ **现存行（本机 exam_system 1264 行）一律 false**，
  // 既有登录 / 改密 / 令牌链路行为**零变化**；由建号 / 重置口令链路置 true，改密成功后置 false。
  // 应用侧（随机临时口令、强制改密中间件、前端跳转）见 W2-P5 / t35。
  mustChangePassword Boolean @default(false) @map("must_change_password")

  // 关系
  questions            Question[]         @relation("TeacherQuestions")
  assignments          Assignment[]       @relation("TeacherAssignments")
  teacherClasses       TeacherClass[]
  teacherSchools       TeacherSchool[]
  studentClasses       StudentClass[]
  submissionsAsStudent Submission[]       @relation("StudentSubmissions")
  teamsCreated         Team[]             @relation("TeamCreator")
  teamMemberships      TeamTeacher[]
  projects             Project[]          @relation("TeacherProjects")
  projectSubmissions   ProjectSubmission[] @relation("StudentProjectSubmissions")

  @@unique([username])
  @@index([username, role])
  @@map("users")
}

enum UserRole {
  super_admin
  teacher
  student
}

// ============================
// 2. schools — 学校表
// ============================
model School {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  name         String    @db.VarChar(200)
  officialCode String?   @unique @map("official_code") @db.VarChar(20)
  province     String?   @db.VarChar(50)
  city         String?   @db.VarChar(50)
  level        String?   @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at")

  classes        Class[]
  teacherSchools TeacherSchool[]
  teams          Team[]

  @@map("schools")
}

// ============================
// 3. classes — 班级表
// ============================
model Class {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  name      String    @db.VarChar(100)
  schoolId  Int       @map("school_id") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at")

  school             School              @relation(fields: [schoolId], references: [id])
  teacherClasses     TeacherClass[]
  studentClasses     StudentClass[]
  assignmentClasses  AssignmentClass[]
  teamClasses        TeamClass[]
  projectClasses     ProjectClass[]

  @@index([schoolId])
  @@map("classes")
}

// ============================
// 4. teacher_classes — 教师-班级关联表
// ============================
model TeacherClass {
  teacherId Int @map("teacher_id") @db.UnsignedInt
  classId   Int @map("class_id") @db.UnsignedInt

  teacher User  @relation(fields: [teacherId], references: [id])
  class   Class @relation(fields: [classId], references: [id])

  @@id([teacherId, classId])
  @@index([teacherId])
  @@index([classId])
  @@map("teacher_classes")
}

// ============================
// 5. student_classes — 学生-班级关联表
// ============================
model StudentClass {
  studentId Int @map("student_id") @db.UnsignedInt
  classId   Int @map("class_id") @db.UnsignedInt

  student User  @relation(fields: [studentId], references: [id])
  class   Class @relation(fields: [classId], references: [id])

  @@id([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@map("student_classes")
}

// ============================
// 6. teacher_schools — 教师-学校关联表（M2M）
// ============================
model TeacherSchool {
  teacherId Int @map("teacher_id") @db.UnsignedInt
  schoolId  Int @map("school_id") @db.UnsignedInt

  teacher User   @relation(fields: [teacherId], references: [id])
  school  School @relation(fields: [schoolId], references: [id])

  @@id([teacherId, schoolId])
  @@index([teacherId])
  @@index([schoolId])
  @@map("teacher_schools")
}

// ============================
// 7. questions — 题库表
// ============================
model Question {
  id                Int        @id @default(autoincrement()) @db.UnsignedInt
  teacherId         Int        @map("teacher_id") @db.UnsignedInt
  title             String     @db.VarChar(200)
  maxScore          Float      @default(100) @map("max_score")
  difficulty        Difficulty
  type              QuestionType @default(code)
  material          String?    @db.Text
  attachmentUrl     String?    @map("attachment_url") @db.VarChar(500)
  objectiveSettings Json?      @map("objective_settings")
  scoringRubric     String?    @map("scoring_rubric") @db.Text
  rubricItems       Json?      @map("rubric_items") // 评分标准固定分项缓存（[{item,maxScore}]，评分标准变更时清空重建）
  checkerScript     String?    @map("checker_script") @db.Text // AI 生成的确定性检查脚本（Node.js）
  checkerStatus     String?    @default("none") @map("checker_status") @db.VarChar(20) // none|generating|ready|failed
  checkerMeta       Json?      @map("checker_meta") // {rounds, items, subjective, error, log[]}
  createdAt         DateTime   @default(now()) @map("created_at")
  deletedAt         DateTime?  @map("deleted_at")

  teacher             User                  @relation("TeacherQuestions", fields: [teacherId], references: [id])
  subQuestions        SubQuestion[]
  assignmentQuestions AssignmentQuestion[]
  submissions         Submission[]

  @@index([teacherId])
  @@map("questions")
}

// ============================
// 7.1 sub_questions — 小题表
// ============================
model SubQuestion {
  id               Int      @id @default(autoincrement()) @db.UnsignedInt
  questionId       Int      @map("question_id") @db.UnsignedInt
  sortOrder        Int      @default(0) @map("sort_order")
  title            String   @db.VarChar(200)
  type             String   @default("code") @db.VarChar(20) // code | objective
  score            Float?
  content          String   @db.Text
  referenceAnswer  String   @map("reference_answer") @db.Text
  language         String   @db.VarChar(30)
  objectiveItems   Json?     @map("objective_items")                               // 客观题小问数组
  scoringCriteria  String?  @map("scoring_criteria") @db.Text

  question     Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submissions  Submission[]

  @@index([questionId])
  @@map("sub_questions")
}

enum Difficulty {
  easy
  medium
  hard
}

enum QuestionType {
  code
  project
}

// ============================
// 7. assignments — 作业表
// ============================
model Assignment {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  teacherId   Int       @map("teacher_id") @db.UnsignedInt
  title       String    @db.VarChar(200)
  description      String?  @db.Text
  startTime        DateTime @map("start_time")
  endTime         DateTime  @map("end_time")
  allowResubmit   Boolean   @default(false) @map("allow_resubmit")
  mode        String?   @default("exam") @db.VarChar(20)   // 'exam' | 'practice'（US-B5：保留字段，不再作为行为开关）
  maxAttempts Int?      @map("max_attempts")               // NULL=不限
  // R3-D1（US-B1/US-B4/US-B2）：三开关之②③。nullable + DB 默认值 ⇒ 历史行 = 'last'/'after_publish'（既有行为不变）。
  scorePolicy      String?  @default("last") @map("score_policy") @db.VarChar(16)              // 'best'=取最高(bestScore) | 'last'=取最后(最新 aiScore)
  answerVisibility String?  @default("after_publish") @map("answer_visibility") @db.VarChar(16) // 'immediate'=评分完成即可见 | 'after_publish'=发布后可见
  locked      Boolean   @default(false)                    // 教师锁定
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  teacher            User                  @relation("TeacherAssignments", fields: [teacherId], references: [id])
  assignmentQuestions AssignmentQuestion[]
  assignmentClasses  AssignmentClass[]
  submissions        Submission[]

  @@index([teacherId])
  @@map("assignments")
}

// ============================
// 8. assignment_questions — 作业-题目关联表
// ============================
model AssignmentQuestion {
  assignmentId Int @map("assignment_id") @db.UnsignedInt
  questionId   Int @map("question_id") @db.UnsignedInt
  sortOrder    Int @default(0) @map("sort_order")

  // W8（R2-B1）：发布时冻结的 rubric/物料快照 + 标准包哈希 + 来源标记。
  // 全部可空 ⇒ 与旧代码兼容；读取方必须用 snapshot ?? live 语义（批 2 W2/W3 落地）。
  rubricSnapshot   Json?   @map("rubric_snapshot")
  materialSnapshot String? @map("material_snapshot") @db.Text
  standardHash     String? @map("standard_hash") @db.VarChar(80)
  snapshotOrigin   String? @map("snapshot_origin") @db.VarChar(16)

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  question   Question   @relation(fields: [questionId], references: [id])

  @@id([assignmentId, questionId])
  @@index([assignmentId])
  @@map("assignment_questions")
}

// ============================
// 9. assignment_classes — 作业-班级关联表
// ============================
model AssignmentClass {
  assignmentId Int @map("assignment_id") @db.UnsignedInt
  classId      Int @map("class_id") @db.UnsignedInt

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  class      Class      @relation(fields: [classId], references: [id])

  @@id([assignmentId, classId])
  @@index([classId])
  @@map("assignment_classes")
}

// ============================
// 10. submissions — 提交/评分表
// ============================
model Submission {
  id              Int              @id @default(autoincrement()) @db.UnsignedInt
  assignmentId    Int              @map("assignment_id") @db.UnsignedInt
  studentId       Int              @map("student_id") @db.UnsignedInt
  questionId      Int              @map("question_id") @db.UnsignedInt
  subQuestionId   Int?             @map("sub_question_id") @db.UnsignedInt
  answer          String?          @db.Text
  aiScore         Int?             @map("ai_score")
  aiFeedback      String?          @map("ai_feedback") @db.Text
  finalScore      Int?             @map("final_score")
  teacherFeedback String?          @map("teacher_feedback") @db.Text
  status          SubmissionStatus @default(draft)
  submittedAt     DateTime?        @map("submitted_at")
  reviewedAt      DateTime?        @map("reviewed_at")
  attemptCount    Int              @default(0) @map("attempt_count")
  bestScore       Int?             @map("best_score")

  // R2-B3（W6）：装置消费回写 —— checker 版本 / 规范化结果哈希 / 陈旧标记（审计与零 LLM 复用依据）
  checkerId        String?          @map("checker_id") @db.VarChar(80)
  canonicalSha256  String?          @map("canonical_sha256") @db.VarChar(80)
  gradingStale     Boolean?         @map("grading_stale")

  assignment  Assignment   @relation(fields: [assignmentId], references: [id])
  student     User         @relation("StudentSubmissions", fields: [studentId], references: [id])
  question    Question     @relation(fields: [questionId], references: [id])
  subQuestion SubQuestion? @relation(fields: [subQuestionId], references: [id])

  @@unique([assignmentId, studentId, questionId, subQuestionId])
  @@index([studentId])
  @@index([assignmentId])
  @@index([status])
  @@index([assignmentId, status])
  @@index([status, submittedAt])
  @@index([subQuestionId])
  @@map("submissions")
}

// ============================
// 11. teams — 教学团队表

// ============================
// 11. teams — 教学团队表
// ============================
model Team {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  name      String    @db.VarChar(100)
  schoolId  Int       @map("school_id") @db.UnsignedInt
  createdBy Int       @map("created_by") @db.UnsignedInt
  createdAt DateTime  @default(now()) @map("created_at")

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creator  User            @relation("TeamCreator", fields: [createdBy], references: [id])
  teachers TeamTeacher[]
  classes  TeamClass[]

  @@map("teams")
}

model TeamTeacher {
  teamId    Int @map("team_id") @db.UnsignedInt
  teacherId Int @map("teacher_id") @db.UnsignedInt

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teacher User @relation(fields: [teacherId], references: [id])

  @@id([teamId, teacherId])
  @@map("team_teachers")
}

model TeamClass {
  teamId  Int @map("team_id") @db.UnsignedInt
  classId Int @map("class_id") @db.UnsignedInt

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id])

  @@id([teamId, classId])
  @@map("team_classes")
}

// ============================
// 12. system_configs — 系统配置表
// ============================
model SystemConfig {
  id    Int    @id @default(autoincrement()) @db.UnsignedInt
  key   String @unique @db.VarChar(64)
  value String @db.Text
  @@map("system_configs")
}

enum SubmissionStatus {
  draft
  submitted
  ai_graded
  reviewed
  published
}

// ============================
// 13. projects — 实训任务表
// ============================
model Project {
  id             Int           @id @default(autoincrement()) @db.UnsignedInt
  teacherId      Int           @map("teacher_id") @db.UnsignedInt
  title          String        @db.VarChar(200)
  description    String?       @db.Text
  startTime      DateTime      @map("start_time")
  endTime        DateTime      @map("end_time")
  machineWeight  Float         @default(0.3) @map("machine_weight")
  astWeight      Float         @default(0.3) @map("ast_weight")
  aiWeight       Float         @default(0.4) @map("ai_weight")
  machineConfig  Json?         @map("machine_config")
  aiPromptExtra  String?       @map("ai_prompt_extra") @db.Text
  status         ProjectStatus @default(draft)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  teacher      User                @relation("TeacherProjects", fields: [teacherId], references: [id])
  classes      ProjectClass[]
  files        ProjectFile[]
  submissions  ProjectSubmission[]

  @@index([teacherId])
  @@index([status])
  @@map("projects")
}

enum ProjectStatus {
  draft
  published
  closed
}

// ============================
// 14. project_classes — 任务-班级关联表
// ============================
model ProjectClass {
  projectId Int @map("project_id") @db.UnsignedInt
  classId   Int @map("class_id") @db.UnsignedInt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])

  @@id([projectId, classId])
  @@index([classId])
  @@map("project_classes")
}

// ============================
// 15. project_files — 工程文件树表（标准工程）
// ============================
model ProjectFile {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  projectId  Int      @map("project_id") @db.UnsignedInt
  path       String   @db.VarChar(500)
  name       String   @db.VarChar(200)
  type       FileType
  language   String?  @db.VarChar(30)
  size       Int?     @db.UnsignedInt
  parentPath String?  @map("parent_path") @db.VarChar(500)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, parentPath])
  @@map("project_files")
}

enum FileType {
  file
  directory
}

// ============================
// 16. project_submissions — 学生提交表
// ============================
model ProjectSubmission {
  id               Int                      @id @default(autoincrement()) @db.UnsignedInt
  projectId        Int                      @map("project_id") @db.UnsignedInt
  studentId        Int                      @map("student_id") @db.UnsignedInt
  machineScore     Float?                   @map("machine_score")
  machineFeedback  String?                  @map("machine_feedback") @db.Text
  astScore         Float?                   @map("ast_score")
  astFeedback      String?                  @map("ast_feedback") @db.Text
  aiScore          Float?                   @map("ai_score")
  aiFeedback       String?                  @map("ai_feedback") @db.Text
  totalScore       Float?                   @map("total_score")
  finalScore       Float?                   @map("final_score")
  teacherFeedback  String?                  @map("teacher_feedback") @db.Text
  status           ProjectSubmissionStatus  @default(draft)
  submittedAt      DateTime?                @map("submitted_at")
  reviewedAt       DateTime?                @map("reviewed_at")

  project Project          @relation(fields: [projectId], references: [id])
  student User             @relation("StudentProjectSubmissions", fields: [studentId], references: [id])
  files   SubmissionFile[]

  @@unique([projectId, studentId])
  @@index([projectId])
  @@index([projectId, status])
  @@index([studentId])
  @@map("project_submissions")
}

enum ProjectSubmissionStatus {
  draft
  submitted
  grading
  graded
  reviewed
  published
}

// ============================
// 17. submission_files — 学生提交文件树表
// ============================
model SubmissionFile {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  submissionId Int      @map("submission_id") @db.UnsignedInt
  path         String   @db.VarChar(500)
  name         String   @db.VarChar(200)
  type         FileType
  language     String?  @db.VarChar(30)
  size         Int?     @db.UnsignedInt
  parentPath   String?  @map("parent_path") @db.VarChar(500)

  submission ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([submissionId, parentPath])
  @@map("submission_files")
}

// ============================
// R2-B3（W6/W7）：作业级批改的 checker 持久化与幂等队列
// ============================
model GradingChecker {
  id                 Int      @id @default(autoincrement())
  checkerId          String   @unique @map("checker_id") @db.VarChar(80)
  assignmentId       Int      @map("assignment_id") @db.UnsignedInt
  questionId         Int?     @map("question_id") @db.UnsignedInt
  versionHash        String   @map("version_hash") @db.VarChar(80)
  rubricHash         String   @map("rubric_hash") @db.VarChar(80)
  standardHash       String   @map("standard_hash") @db.VarChar(80)
  status             String   @default("ready") @db.VarChar(16)
  checkerJson        Json     @map("checker_json")
  generatedSessionId String?  @map("generated_session_id") @db.VarChar(160)
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([assignmentId, status])
  @@map("grading_checkers")
}

model GradingJob {
  id           Int      @id @default(autoincrement())
  assignmentId Int      @map("assignment_id") @db.UnsignedInt
  checkerId    String   @map("checker_id") @db.VarChar(80)
  status       String   @default("pending") @db.VarChar(16)
  attempts     Int      @default(0)
  writtenCount Int      @default(0) @map("written_count")
  skippedCount Int      @default(0) @map("skipped_count")
  lastError    String?  @map("last_error") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  /// R2-B35：本次批改使用的内容指纹（复用命中统计/审计；由迁移 20261013090000 添加）
  contentKey   String?  @map("content_key") @db.Char(64)

  // R2-B12②：原「状态入键」唯一约束已由活动键方案替代：
  //   活动态（pending/running）每 (assignment, checker) 至多一行、终态可多行共存。
  //   实现见迁移 20261012030000_r2b12_grading_jobs_active_key（生成列 active_key + UNIQUE）。
  //   注意：生成列未写进本 schema（Prisma 无法表达 GENERATED ALWAYS AS）⇒ 该列由原始 SQL 迁移管理。
  @@index([assignmentId])
  @@index([contentKey])
  @@map("grading_jobs")
}

/// R2-B14①：作业锚点（assignment-manifest 的平台侧持久化副本）。
/// 用途：复用（measure-only-reuse）时把它回填到 run-root，供装置 frozen_intact 预检与消费侧 slug 映射使用。
/// BCNF：唯一非平凡函数依赖是 (assignment_id, checker_id) → 其余属性（候选键即该对）⇒ 满足 BCNF。
model GradingAssignmentAnchor {
  id                      Int      @id @default(autoincrement())
  assignmentId            Int      @map("assignment_id") @db.UnsignedInt
  checkerId               String   @map("checker_id") @db.VarChar(80)
  frozenSha256            String?  @map("frozen_sha256") @db.VarChar(96)
  materialsManifestDigest String?  @map("materials_manifest_digest") @db.VarChar(96)
  nSubmissions            Int      @default(0) @map("n_submissions")
  /// R2-B16①：ingest 时 out/checker/checker.json 的**原始字节**（回填必须字节一致；历史行为 NULL ⇒ 不回填）
  checkerRaw              Bytes?   @map("checker_raw")
  submissionsJson         Json     @map("submissions_json")
  anchorJson              Json     @map("anchor_json")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@unique([assignmentId, checkerId])
  @@map("grading_assignment_anchors")
}

/// R2-B35：内容指纹 → 尺子（全局唯一）。同 content_key 默认跨班/跨教师复用；命中即零 LLM。
/// 解析流程与并发去重见 server/src/services/dshRulerStore.js（原始 SQL 读写，不依赖 Client 生成）。
/// BCNF：唯一非平凡 FD = content_key → 其余属性（候选键即 content_key）⇒ 满足 BCNF。
model GradingRuler {
  id                BigInt   @id @default(autoincrement())
  contentKey        String   @unique @map("content_key") @db.Char(64)
  status            String   @default("building") @db.VarChar(20)
  checkerId         String?  @map("checker_id") @db.VarChar(80)
  standardSha256    String?  @map("standard_sha256") @db.VarChar(80)
  rubricSha256      String?  @map("rubric_sha256") @db.VarChar(80)
  descriptionSha256 String?  @map("description_sha256") @db.VarChar(80)
  model             String?  @db.VarChar(64)
  sourceRunId       BigInt?  @map("source_run_id")
  frozenSha256      String?  @map("frozen_sha256") @db.VarChar(96)
  /// 尺子原始字节（复用落位必须逐字节一致；沿用既有锚点机制）
  checkerRaw        Bytes?   @map("checker_raw")
  /// status=failed 时的原因留痕（可重试）
  lastError         String?  @map("last_error") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([checkerId])
  @@index([status])
  @@map("grading_rulers")
}

/// R2-B36：每次运行的使用量/费用/工具调用（取证阶段抽取；读写走原始 SQL，见 src/services/dshRunUsageStore.js）。
/// BCNF：唯一非平凡 FD = run_ref → 其余属性（候选键即 run_ref）⇒ 满足 BCNF。
model GradingRunUsage {
  id                 BigInt   @id @default(autoincrement())
  runRef             String   @unique @map("run_ref") @db.VarChar(160)
  jobId              BigInt?  @map("job_id")
  model              String?  @db.VarChar(64)
  modelCalls         Int      @default(0) @map("model_calls")
  uncachedInputTokens BigInt  @default(0) @map("uncached_input_tokens")
  outputTokens       BigInt   @default(0) @map("output_tokens")
  cacheReadTokens    BigInt   @default(0) @map("cache_read_tokens")
  cacheWriteTokens   BigInt   @default(0) @map("cache_write_tokens")
  cacheHitRate       Decimal? @map("cache_hit_rate") @db.Decimal(9, 6)
  costTotal          Decimal? @map("cost_total") @db.Decimal(18, 6)
  costCurrency       String?  @map("cost_currency") @db.VarChar(8)
  priceVersion       String?  @map("price_version") @db.VarChar(64)
  priceTier          String?  @map("price_tier") @db.VarChar(16)
  noModelSession     Boolean  @default(false) @map("no_model_session")
  toolsJson          Json?    @map("tools_json")
  sessionsJson       Json?    @map("sessions_json")
  usageJson          Json?    @map("usage_json")
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([jobId])
  @@map("grading_run_usage")
}

/// R2-B35：作业-题目 → 当时所用尺子（历史分数不可变的锚）。
/// BCNF：唯一非平凡 FD = (assignment_id, question_id) → 其余属性 ⇒ 该对即候选键。
model AssignmentQuestionRuler {
  id           BigInt   @id @default(autoincrement())
  assignmentId Int      @map("assignment_id") @db.UnsignedInt
  questionId   Int      @map("question_id") @db.UnsignedInt
  rulerId      BigInt   @map("ruler_id")
  boundAt      DateTime @default(now()) @map("bound_at") @db.DateTime(3)

  @@unique([assignmentId, questionId])
  @@index([rulerId])
  @@map("assignment_question_rulers")
}

/// R2-B23：每次运行的摘要（job_id 唯一）——归档目录、计数、会话销毁证据
model GradingJobRun {
  id              Int       @id @default(autoincrement())
  jobId           Int       @unique @map("job_id") @db.UnsignedInt
  assignmentId    Int       @map("assignment_id") @db.UnsignedInt
  checkerId       String?   @map("checker_id") @db.VarChar(80)
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  deviceExit      Int?      @map("device_exit")
  measured        Int       @default(0)
  unmeasurable    Int       @default(0)
  skipped         Int       @default(0)
  written         Int       @default(0)
  teardownJson    Json?     @map("teardown_json")
  runDir          String?   @map("run_dir") @db.VarChar(500)
  logStdout       String?   @map("log_stdout") @db.Text
  logStderr       String?   @map("log_stderr") @db.Text
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime  @map("updated_at")

  @@index([assignmentId])
  @@map("grading_job_runs")
}
/// R2-B48：会话内生成「自然语言总评」的缓存（summary_key = sha256(content_key + 结果摘要)）
/// 自然失效：rubric/尺子内容变化 ⇒ content_key 变化 ⇒ summary_key 变化 ⇒ 必 miss（无需清理任务）
model GradingSummary {
  summaryKey    String   @id @map("summary_key") @db.Char(71)
  contentKey    String   @map("content_key") @db.Char(71)
  resultDigest  String   @map("result_digest") @db.Char(71)
  text          String   @db.Text
  facts         Json?    @map("facts")
  model         String?  @db.VarChar(100)
  promptVersion String?  @map("prompt_version") @db.VarChar(40)
  tokens        Json?    @map("tokens")
  source        String?  @db.VarChar(40)
  hits          Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([contentKey])
  @@map("grading_summaries")
}
