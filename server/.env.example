# 数据库
DATABASE_URL=mysql://root:PASSWORD@localhost:3306/exam_system
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=exam_system

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 内部评分完成回调共享密钥（缺失 ⇒ 拒绝启动；不得使用字面量兜底/默认值）
INTERNAL_SECRET=
# 内部回调来源白名单（可选，逗号分隔的可信代理 IP；回环地址始终放行）
INTERNAL_ALLOWED_IPS=

# 反向代理：缺省信任 1 层（nginx）；可用 loopback / false / 具体 IP / 跳数收窄
TRUST_PROXY=
# 允许的跨源来源（可选，逗号分隔；缺省仅本机开发源）——socket.io 亦复用/可经 SOCKET_CORS_ORIGIN 覆盖
CORS_ORIGIN=
SOCKET_CORS_ORIGIN=

# 首次引导超管口令（可选）：仅当 admin 账号不存在时用于建号；未配置则不自动建超管，且绝不修改现存账号
BOOTSTRAP_ADMIN_PASSWORD=

# 服务端口
PORT=3000

# 日志级别
LOG_LEVEL=info
