# /etc/dsh-grader/worker.env   —— 直接 `cp worker.env.example /etc/dsh-grader/worker.env`
# ★权限：chmod 600 /etc/dsh-grader/worker.env（含数据库口令），owner = 运行用户（如 root 或 exam）

# ① 必填：数据库连接（生产库；worker 只允许写 exam_system，且需 --allow-db + --allow-prod 双开关）
DATABASE_URL=mysql://exam_app:CHANGE_ME@127.0.0.1:3306/exam_system

# ② 必填：本次批改的提交份数（与装置 --submissions 对齐；云上应由「导出该作业提交」的步骤决定）
GRADER_SUBMISSIONS=63

# ③ 必填：僵尸 running 回收阈值（毫秒）。必须 > 单次运行超时时间；缺省 900000（15 分钟）
DSH_WORKER_STALE_RUNNING_MS=900000

# ④ 可选：DSH CLI 路径（等价于 service 里的 Environment=DSH_GRADER_BIN=…）
#DSH_GRADER_BIN=/opt/dsh/runtime/cli/bin/dsh
# ⑤ 可选：装置 profile 与真实 home（默认 headless / $HOME/.dsh）
#DSH_GRADER_PROFILE=headless
#DSH_GRADER_REAL_HOME=/root/.dsh
# ⑥ 可选：worker 空转退避（常驻形态才有意义）
#DSH_WORKER_IDLE_BACKOFF_MS=500
#DSH_WORKER_MAX_BACKOFF_MS=30000

# ⑦ 不需要在此配置模型凭据：worker 从平台 system_configs 读 deepseek_model / deepseek_base_url / deepseek_api_key
#    并只在子进程环境里透传给装置（不落盘）；装置自身也支持 env:DEEPSEEK_API_KEY 覆盖。